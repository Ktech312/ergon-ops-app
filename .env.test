# Dummy values for the test suite only -- Vite loads this automatically
# for mode "test" (vitest's default), consistently across every module's
# own import.meta.env transform. Confirmed empirically that vitest's
# `test.env` config option and `vi.stubEnv` do NOT reliably reach
# import.meta.env inside a module the test file imports (only the test
# file's own import.meta.env) -- a real .env.test file avoids that
# module-boundary gap entirely, since Vite resolves it once at config
# time for everything. Not a real Supabase project -- never used for a
# live request, only to make isRemotePersistenceConfigured() true so
# the loaders under test take their real code path instead of the
# early-return guard clause.
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key
